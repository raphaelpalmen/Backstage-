{
  "rules": {
    "backstage": {
      "appUsers": {
        ".read": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/superadmin').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'superadmin')",

        "$uid": {
          ".read": "auth != null && ($uid === auth.uid || root.child('backstage/appUsers/'+auth.uid+'/roles/superadmin').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'superadmin')",

          ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/superadmin').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'superadmin' || ($uid === auth.uid && !data.exists() && newData.child('pending').val() === true && !newData.hasChild('roles') && !newData.child('role').exists()))",

          "name":            { ".write": "auth != null && ($uid === auth.uid || root.child('backstage/appUsers/'+auth.uid+'/roles/superadmin').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'superadmin')" },
          "mustSetPassword": { ".write": "auth != null && ($uid === auth.uid || root.child('backstage/appUsers/'+auth.uid+'/roles/superadmin').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'superadmin')" }
        }
      },

      "ops": {
        "events": {
          "$eid": {

            ".read": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/superadmin').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'superadmin' || ((root.child('backstage/appUsers/'+auth.uid+'/roles').exists() || root.child('backstage/appUsers/'+auth.uid+'/role').exists()) && root.child('backstage/appUsers/'+auth.uid+'/pending').val() !== true && (root.child('backstage/appUsers/'+auth.uid+'/allEvents').val() !== false || root.child('backstage/appUsers/'+auth.uid+'/events/'+$eid).val() === true)))",

            ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/superadmin').val() === true || root.child('backstage/appUsers/'+auth.uid+'/roles/leitung').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'superadmin' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'leitung' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'admin' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'abendleitung' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'techniker')",

            "artists": {
              "$aid": {
                "riderDone": { ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/artistcare').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'artistcare' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'care')" }
              }
            },

            "status": {
              ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/artistcare').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'artistcare' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'care')"
            },

            "pickups": {
              "$pid": {
                "done":   { ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/fahrer').val() === true || root.child('backstage/appUsers/'+auth.uid+'/roles/artistcare').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'fahrer' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'artistcare')" },
                "doneAt": { ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/fahrer').val() === true || root.child('backstage/appUsers/'+auth.uid+'/roles/artistcare').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'fahrer' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'artistcare')" },
                "doneBy": { ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/fahrer').val() === true || root.child('backstage/appUsers/'+auth.uid+'/roles/artistcare').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'fahrer' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'artistcare')" },
                "time":   { ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/fahrer').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'fahrer')" }
              }
            },

            "travel": {
              "$tid": {
                "done":   { ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/fahrer').val() === true || root.child('backstage/appUsers/'+auth.uid+'/roles/artistcare').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'fahrer' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'artistcare')" },
                "doneAt": { ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/fahrer').val() === true || root.child('backstage/appUsers/'+auth.uid+'/roles/artistcare').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'fahrer' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'artistcare')" },
                "time":   { ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/fahrer').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'fahrer')" }
              }
            },

            "guestlist": {
              ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/einlass').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'einlass' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'kasse')"
            },
            "friendslist": {
              ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/einlass').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'einlass' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'kasse')"
            },

            "kasse": {
              "blocks": {
                ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/einlass').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'einlass' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'kasse')"
              },
              "payouts": {
                ".write": "auth != null && (root.child('backstage/appUsers/'+auth.uid+'/roles/einlass').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'einlass' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'kasse')"
              },
              "settlements": {
                "$sid": {
                  ".write": "auth != null && !data.exists() && (root.child('backstage/appUsers/'+auth.uid+'/roles/superadmin').val() === true || root.child('backstage/appUsers/'+auth.uid+'/roles/leitung').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'superadmin' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'leitung' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'abendleitung' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'admin')"
                }
              }
            },

            "drivers": {
              "$did": {
                ".write": "auth != null && ($did === auth.uid || root.child('backstage/appUsers/'+auth.uid+'/roles/superadmin').val() === true || root.child('backstage/appUsers/'+auth.uid+'/roles/leitung').val() === true || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'superadmin' || root.child('backstage/appUsers/'+auth.uid+'/role').val() === 'leitung')"
              }
            }
          }
        }
      }
    }
  }
}
